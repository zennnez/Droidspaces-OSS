# Droidspaces SELinux policy - Magisk/KernelSU/APatch module format
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>
# SPDX-License-Identifier: GPL-3.0-or-later

# Type declarations
type droidspacesd domain
type ksu domain
type magisk domain
type su domain
type droidspacesd_exec exec_type
permissive droidspacesd

# droidspacesd_exec
allow droidspacesd_exec droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow droidspacesd_exec labeledfs filesystem associate

# init
allow init droidspacesd process { noatsecure rlimitinh siginh transition }
allow init droidspacesd process2 nosuid_transition
allow init droidspacesd_exec file { execute getattr map open read }
allow init droidspacesd_exec lnk_file { getattr read }
allow init system_data_file file { execute getattr map open read }

# kernel
allow kernel device blk_file { create getattr setattr unlink }
allow kernel device chr_file { create setattr }
allow kernel device dir { add_name write }
allow kernel droidspacesd fd use
allow kernel system_data_file file { getattr open read write }
allow kernel vold_data_file file { getattr open read write }

# magisk
allow magisk droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow magisk droidspacesd process2 nosuid_transition
allow magisk droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow magisk system_data_file file entrypoint

# netd
allow netd proc_net dir add_name
allow netd proc_net file create

# ksu
allow ksu droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow ksu droidspacesd process2 nosuid_transition
allow ksu droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow ksu system_data_file file entrypoint

# servicemanager
allow servicemanager droidspacesd binder { call transfer }
allow servicemanager droidspacesd dir search
allow servicemanager droidspacesd file { getattr open read }
allow servicemanager droidspacesd process getattr

# su
allow su droidspacesd process { dyntransition noatsecure rlimitinh siginh transition }
allow su droidspacesd process2 nosuid_transition
allow su droidspacesd_exec file { entrypoint execute execute_no_trans getattr map open read relabelfrom relabelto }
allow su system_data_file file entrypoint

# system_server
allow system_server droidspacesd binder { call transfer }
allow system_server droidspacesd fd use
allow system_server droidspacesd fifo_file write

# for Termux:X11 and DRI3 denials in daemon mode
allow untrusted_app_27 droidspacesd fd use
allow untrusted_app_27 droidspacesd fifo_file write

# for pulseAudio
allow audioserver droidspacesd binder { call transfer }
allow audioserver droidspacesd fd use
allow mediaserver droidspacesd binder { call transfer }
allow mediaserver droidspacesd fd use

# fix permission denied when read/write mounted storage (#213)
allow mediaprovider_app droidspacesd fd use

# for anland (Wayland display consumer app and DRI3 buffer sharing)
allow untrusted_app droidspacesd fd use
allow untrusted_app_27 droidspacesd fd use
allow untrusted_app_29 droidspacesd fd use
allow untrusted_app_30 droidspacesd fd use
allow untrusted_app_32 droidspacesd fd use
allow untrusted_app_33 droidspacesd fd use
allow untrusted_app_34 droidspacesd fd use
allow untrusted_app_35 droidspacesd fd use
allow untrusted_app_all droidspacesd fd use
allow untrusted_app droidspacesd fifo_file write
allow untrusted_app_27 droidspacesd fifo_file write
allow untrusted_app_33 droidspacesd fifo_file write
allow untrusted_app_34 droidspacesd fifo_file write
allow untrusted_app_35 droidspacesd fifo_file write
allow untrusted_app_all droidspacesd fifo_file write
allow untrusted_app droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app_27 droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app_33 droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app_34 droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app_35 droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app_all droidspacesd unix_stream_socket { connectto read write }
allow untrusted_app su unix_stream_socket { read write }
allow untrusted_app_27 su unix_stream_socket { read write }
allow surfaceflinger droidspacesd fd use
allow hal_graphics_composer_default droidspacesd fd use

# for sparse loop images and external storage mounts
allow kernel sdcardfs file { getattr open read write }
allow kernel fuse file { getattr open read write }
allow kernel media_rw_data_file file { getattr open read write }
allow droidspacesd loop_control_device chr_file { ioctl open read write getattr setattr }
allow droidspacesd loop_device blk_file { ioctl open read write getattr setattr }
allow droidspacesd vold_data_file file { getattr open read write map create unlink }
allow droidspacesd media_rw_data_file file { getattr open read write map create unlink }
allow droidspacesd sdcardfs file { getattr open read write map create unlink }
allow droidspacesd fuse file { getattr open read write map create unlink }
